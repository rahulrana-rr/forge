# PostgreSQL connection (local default below; see docker-compose.yml for a containerised option)
DATABASE_URL="postgresql://<os-user>@localhost:5432/gymapp"

# better-auth
# Required. Generate with: openssl rand -base64 32 (at least 32 characters). Left empty on purpose:
# better-auth refuses to start until a real value is set, and production also rejects short secrets.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional; the Google button hides itself when these are missing)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to "1" to show the Google button in the UI (client-side flag; keep in sync with the two values above)
NEXT_PUBLIC_AUTH_GOOGLE="0"

# Auth email delivery (magic links, email verification on sign-up, password reset).
# Required in production: without it sign-up, password reset and magic links fail there.
# In development the links are logged to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="FORGE <noreply@example.com>"

# Coach review (Claude). Without a key the app still works; workouts show as "not reviewed".
ANTHROPIC_API_KEY=""
# Optional: override the coach model (default claude-opus-5-5)
COACH_MODEL=""

# Exercise media CDN. Default is the app's own /media path (public/media). Point at an object store
# or CDN that mirrors public/media to serve demos from there, e.g. https://media.example.com/forge
NEXT_PUBLIC_MEDIA_BASE_URL=""

# Assigned programs (lib/programs). Server only: a JSON object keyed by lowercased email, e.g.
# {"<email>":{"programId":"returning-lifter-calisthenics-7wk","startDate":"YYYY-MM-DD"}}
# Invalid JSON means no assignments. Never commit real emails; set this in the deployment's env.
PROGRAM_ASSIGNMENTS=""
# Development only (ignored in production builds): preview one program as a guest, e.g.
# {"programId":"returning-lifter-calisthenics-7wk","startDate":"YYYY-MM-DD"}
NEXT_PUBLIC_DEV_PROGRAM_ASSIGNMENT=""
